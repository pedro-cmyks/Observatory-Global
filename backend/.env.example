# ObservatorioGlobal Backend — Environment Variables
# Copy to .env for local dev. Never commit .env with real values.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://observatory:changeme@localhost:5432/observatory?sslmode=disable

# ── News API Keys ─────────────────────────────────────────────────────────────
# NewsData.io — multilingual, 60+ languages. Free: 200 req/day
# https://newsdata.io/dashboard
NEWSDATA_API_KEY=

# MediaStack — Spanish/Portuguese LatAm supplement. Free: 500 req/month
# https://mediastack.com/dashboard
MEDIASTACK_API_KEY=

# NewsAPI.org — targeted crisis queries. Developer: 100 req/day
# https://newsapi.org
NEWSAPI_KEY=

# Reddit — social/discussion layer (source_family='social'). NO CREDENTIALS:
# the JSON Data API needs OAuth + (since Nov-2025) pre-approval, but the public
# Atom RSS surface `/r/<sub>/.rss` is credential-free and returns 200 to a
# browser User-Agent. ingest_reddit fetches COMBINED feeds (/r/a+b+c/.rss) to
# minimise per-IP rate limiting, runs every 4th GDELT cycle (~60 min), and is
# ON by default. Nothing to set for it to work.
# Optional knobs (all have sane defaults):
REDDIT_INGEST_ENABLED=true       # kill-switch: false/0/no/off to disable
# REDDIT_RSS_CHUNK=4             # subreddits combined per request
# REDDIT_RSS_DELAY=15           # seconds between chunk requests
# Lemmy social ingest (Unified Engine F1.2) — federated forum, instance=country/lang.
# Uncredentialled JSON API; ON by default.
LEMMY_INGEST_ENABLED=true        # kill-switch: false/0/no/off to disable
# LEMMY_POST_LIMIT=30           # newest Local posts fetched per instance
# LEMMY_DELAY=2                 # seconds between instances
# LEMMY_WINDOW_HOURS=6          # only ingest posts newer than this
# REDDIT_USER_AGENT=            # browser-like UA (Reddit rejects bot UAs)

# ── Optional Connectors ───────────────────────────────────────────────────────
# ACLED — conflict event data. System works without these (returns empty layer).
# Request access at https://acleddata.com/register
ACLED_API_KEY=
ACLED_EMAIL=

# ── Ingestion Tuning ──────────────────────────────────────────────────────────
# GDELT cycle interval in seconds (default: 900 = 15 min)
INGEST_INTERVAL_SECONDS=900
# Cheap hot-window enrichment that runs before transformer NLP and keeps
# nlp_processed_at NULL so transformer quality can overwrite it later.
NLP_FAST_LANE_ENABLED=true
NLP_FAST_LANE_HOURS=24
NLP_FAST_LANE_LIMIT=10000

# ── Local Hot/Cold Archive Worker ─────────────────────────────────────────────
# Local-only archive path for historical signals. Keep outside the repo.
ATLAS_ARCHIVE_DIR=/Users/pedro/AtlasArchive
# Preferred local maintenance window (America/Bogota / UTC-5).
LOCAL_WORKER_TIMEZONE=America/Bogota
LOCAL_WORKER_WINDOW_START=00:00
LOCAL_WORKER_WINDOW_END=06:00

# ── Redis (optional caching) ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
