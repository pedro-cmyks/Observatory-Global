<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.atlas.embed-hot-corpus</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/pedro/AtlasLocalWorker/run-embed-hot-corpus.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/pedro/AtlasLocalWorker</string>

  <key>RunAtLoad</key>
  <false/>

  <!-- Every 6h, offset :30 to stay clear of the emergent snapshot at :00 -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>30</integer></dict>
  </array>

  <key>StandardOutPath</key>
  <string>/Users/pedro/AtlasLocalWorker/logs/embed-hot-corpus.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/pedro/AtlasLocalWorker/logs/embed-hot-corpus.err.log</string>

  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>10</integer>
</dict>
</plist>
